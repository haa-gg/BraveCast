{
  "manifest_version": 3,
  "name": "Stream Caster",
  "version": "2.0",
  "description": "One-click beam ad-free streams to Glen's MacBook (2) over Tailscale.",
  "permissions": [
    "activeTab",
    "tabs",
    "scripting",
    "webRequest",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Stream Caster • Cast to Glen's MacBook",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
